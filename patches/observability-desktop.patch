 import type { ChartDataPoint, ChartConfig } from '../types';
+import { useEventEmojis } from '../composables/useEventEmojis';
+
+const { getEmojiForEventType, getEmojiForToolName } = useEventEmojis();
+const ICON_STEP = 22;     // vertical pitch of one stacked icon badge
+const MAX_ICONS = 3;      // icons per bar; the rest collapse into "+n"
+const EMOJI_FONT = '15px "Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif';
+
+// Distinct icons for one bucket, most frequent first: the tool for tool events (❌ when it failed),
+// the event type for everything else (prompt, stop, notification, …).
+function bucketIcons(point: ChartDataPoint): { icons: string[]; extra: number } {
+  const counts = new Map<string, number>();
+  const add = (emoji: string, n: number) => counts.set(emoji, (counts.get(emoji) || 0) + n);
+  const toolTypes = new Set<string>();
+  for (const [key, n] of Object.entries(point.toolEvents || {})) {
+    const sep = key.indexOf(':');
+    const type = key.slice(0, sep);
+    const tool = key.slice(sep + 1);
+    toolTypes.add(type);
+    add(type === 'PostToolUseFailure' ? '❌' : getEmojiForToolName(tool), n);
+  }
+  for (const [type, n] of Object.entries(point.eventTypes || {})) {
+    if (!toolTypes.has(type)) {
+      add(getEmojiForEventType(type), n);
+    }
+  }
+  const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([e]) => e);
+  return { icons: sorted.slice(0, MAX_ICONS), extra: Math.max(0, sorted.length - MAX_ICONS) };
+}
 
